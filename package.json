{
  "name": "kknvrs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "kknvrs — universal OpenTUI tester for web MCPs/SaaS apps (in-CLI ReAct loop over Ollama + external MCPs only)",
  "bin": {
    "kknvrs": "./dist/main.js"
  },
  "scripts": {
    "dev": "NODE_OPTIONS=--experimental-ffi tsx src/main.tsx",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "NODE_OPTIONS=--experimental-ffi node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "^0.5.11",
    "@opentui/react": "^0.5.11",
    "cli-spinners": "^3.4.0",
    "react": "^19.2.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "shadcn": "^4.21.0",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
